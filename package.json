{
  "name": "gh-ci-compact",
  "version": "0.0.1",
  "description": "Compact GitHub Actions jobs into parallel, machine-readable CI.",
  "type": "module",
  "bin": {
    "gh-ci-compact": "./dist/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
